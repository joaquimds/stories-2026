    "db:seed": "node --env-file-if-exists=.env scripts/seed.ts",
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "email:preview": "node --env-file-if-exists=.env scripts/preview-emails.ts"
